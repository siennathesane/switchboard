#!/bin/sh
# Keeps a switchboard broker alive while /var/run/sb-enabled exists.
# Restarts the broker when the process dies (crash, SIGKILL, lost lock
# race) or when the process is up but the client port stays closed for
# ~30s (wedged). The enable flag is how the Jepsen kill nemesis keeps a
# node down: kill! removes the flag before pkill; start! re-arms it.
#
# Liveness is judged by pgrep, not the pidfile: the pidfile can name a
# broker that lost the RocksDB lock race against a concurrent starter
# (Jepsen start! vs this watchdog), and acting on a stale pid meant
# start-spam against the live broker or restarts that never happened.
fails=0
while :; do
  sleep 1
  [ -f /var/run/sb-enabled ] || continue
  if pgrep -x switchboard >/dev/null 2>&1; then
    if nc -z 127.0.0.1 5672 >/dev/null 2>&1; then
      fails=0
    else
      fails=$((fails+1))
      if [ "$fails" -ge 30 ]; then
        pkill -9 -x switchboard
        sleep 1
        if [ -f /var/run/sb-args ]; then
          /usr/local/bin/sb-start $(cat /var/run/sb-args) >/dev/null 2>&1 || true
        fi
        fails=0
      fi
    fi
  else
    fails=0
    if [ -f /var/run/sb-args ]; then
      /usr/local/bin/sb-start $(cat /var/run/sb-args) >/dev/null 2>&1 || true
    fi
  fi
done
