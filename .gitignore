/init.jsonl

# Third-party spec download; docs/ carries the tracked copies
/amqp0-9-1.pdf

# Jepsen: run output, generated build context, and the throwaway SSH keypair
/jepsen/store
/jepsen/docker/broker-ctx
/jepsen/docker/keys

# Benchmark run output
/bench/results
/bench/docker/runner-ctx

# Prebuilt binaries staged for the thin runtime image (built on the k3s host)
/k8s/bin
